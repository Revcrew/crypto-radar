# Copy to proxy.env (mode 600) in the service directory ON THE VDS.
# NEVER commit real values to the repo.
#
# One dedicated proxy with non-US egress (TZ section 1.4).
# Used ONLY for Binance / Bybit / KuCoin requests; all other
# venues go direct. If the proxy dies, those three venues pause
# (~120 s after 2 consecutive errors) and the service continues
# direct-only. Cloudflare WARP is NOT suitable (US exit).
#
# Format: scheme://user:password@host:port

PROXY_URL=http://user:password@proxy-host:port
